    "next": "15.5.29",
    "next-auth": "4.24.15",
    "nodemailer": "^7.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.0.0",
    "stripe": "^18.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/eslintrc": "^3.3.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.29",

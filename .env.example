# Explicitly enable fictional sample events. Disable before importing real listings.
DEMO_MODE=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soukoukai
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
# Passwordless sign-in (SMTP URL, URL-encode credentials).
EMAIL_SERVER=smtps://resend:YOUR_RESEND_API_KEY@smtp.resend.com:465
EMAIL_FROM=Soukoukai <hello@your-verified-domain.com>
# Alerts use the same verified sender through the Resend API.
RESEND_API_KEY=
# Stripe recurring JPY price; configure its amount in Stripe, not the browser.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# A long random secret for GET /api/cron/alerts.
CRON_SECRET=
